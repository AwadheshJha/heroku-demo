{
  "name": "heroku-demo",
  "version": "1.0.0",
  "description": "Automated test suite for login functionality using Cypress",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:firefox": "cypress run --browser firefox",
    "cy:run:headless": "cypress run --headless",
    "cy:run:spec": "cypress run --spec",
    "test": "cypress run",
    "test:chrome": "cypress run --browser chrome --headless",
    "test:firefox": "cypress run --browser firefox --headless",
    "test:login": "cypress run --spec 'cypress/e2e/login.cy.js'",
    "report": "cypress run --reporter mochawesome",
    "clean": "rm -rf cypress/screenshots cypress/videos"
  },
  "keywords": [
    "cypress",
    "automation",
    "testing",
    "login",
    "e2e",
    "javascript"
  ],
  "author": "Awadhesh Jha",
  "license": "MIT",
  "devDependencies": {
    "cypress": "^13.6.0"
  },
  "dependencies": {},
  "engines": {
    "node": ">=16.0.0"
  }
}